# Staged source only. No automatic loading. Original IRIs retained.
@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix quipu: <http://quipu.dev/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Retained Quipu egress gate: src/share_scrub.rs at 2733fefb4ea835b95dd16306e0e53018901dac3f.
aegis:InternalIdentifierPatternShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:path aegis:mustMatch ],
        [ sh:datatype xsd:string ;
            sh:path aegis:mustNotMatch ],
        [ sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass aegis:InternalIdentifierPattern .


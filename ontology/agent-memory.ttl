# No rdfs:domain on any property: a domain would type every subject that uses
# the property (the aegis:expiresAt trap, design §7). Shapes carry the per-class
# constraints instead.

aegis:Preference a rdfs:Class , owl:Class ;
    rdfs:label "Preference" ;
    rdfs:comment "How a person wants things done in one context (camayoc agent memory)." .

aegis:Handoff a rdfs:Class , owl:Class ;
    rdfs:label "Handoff" ;
    rdfs:comment "The one current hand-off note for an agent (camayoc agent memory)." .

aegis:Reference a rdfs:Class , owl:Class ;
    rdfs:label "Reference" ;
    rdfs:comment "Where a system lives and how to reach it (camayoc agent memory)." .

aegis:MemoryTopic a rdfs:Class , owl:Class ;
    rdfs:label "MemoryTopic" ;
    rdfs:comment "A named topic that memory records are filed under; its local name is a natural-key segment." .

aegis:Directive a rdfs:Class , owl:Class ;
    rdfs:label "Directive" ;
    rdfs:comment "A directive, including legacy Directive individuals, scoped separately for memory records." .


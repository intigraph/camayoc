__pycache__/
*.py[cod]
.venv/
*.db
*.db-wal
*.db-shm
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# The br/beads runtime store. `.beads/proxieddb/` was ignored; the store files
# beside it were not, so a `git add -A` in this repo stages ~500 KB of binary
# database plus its .bak snapshots (measured 2026-09-05, aegis-ukg18c — caught
# in review, not committed). Same class as any other runtime artifact: it is
# state, not source.
.beads/dolt*
.beads/.br_recovery/
.beads/*.bak
book-out/

# Runtime signing identities are private per-installation state.
**/.quipu/*.pk8

# Python packaging output for the camayoc CLI (pyproject.toml).
build/
*.egg-info/

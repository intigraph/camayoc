# Generated from shapes/agent-memory.shapes.ttl sha256:356db1c9c33c8e806b1fda6669fab3f80ab9d6b818f1aee967686145b17e9737
# by scripts/memory_schema_proposal.py (aegis-gshu.12). Do not hand-edit.
@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .

aegis:MemoryRecordShape a sh:NodeShape ;
    sh:targetSubjectsOf aegis:naturalKey ;
    sh:property [
        sh:path aegis:naturalKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:name "naturalKey" ;
        sh:description "The record's natural-key IRI (aegis:mem/<kind>/<scope>/<topic>); filled by the tool." ;
        sh:message "Not recorded: the record has no natural key (camayoc tool bug; report it)." ] ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:name "label" ;
        sh:description "One-line label; filled by the tool from the record body." ;
        sh:message "Not recorded: the record has no label (camayoc tool bug; report it)." ] ;
    sh:property [
        sh:path aegis:sourceKind ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "observed" "declared" "inferred" ) ;
        sh:name "sourceKind" ;
        sh:description "Provenance tag: observed, declared or inferred; filled by the tool's sourceKind rule." ;
        sh:message "Not recorded: the record needs exactly one sourceKind of observed, declared or inferred." ] ;
    sh:property [
        sh:path aegis:recordedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:name "recordedAt" ;
        sh:description "UTC instant the record was written; filled by the tool." ;
        sh:message "Not recorded: the record has no recordedAt instant (camayoc tool bug; report it)." ] ;
    sh:property [
        sh:path aegis:recordedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:name "recordedBy" ;
        sh:description "The agent that wrote the record ($SHANTY_AGENT or the harness agent id); filled by the tool." ;
        sh:message "Not recorded: the record does not say which agent wrote it; set SHANTY_AGENT." ] ;
    sh:property [
        sh:path aegis:contentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^sha256:[0-9a-f]{64}$" ;
        sh:name "contentHash" ;
        sh:description "sha256 over the caller-supplied fields; how an unchanged re-record is detected." ;
        sh:message "Not recorded: the record has no content hash (camayoc tool bug; report it)." ] ;
    sh:property [
        sh:path aegis:supersedes ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:name "supersedes" ;
        sh:description "The earlier version this record replaces; filled by the tool on the same natural key." ;
        sh:message "Not recorded: a record supersedes at most one earlier version, by IRI." ] ;
    sh:property [
        sh:path aegis:supersededAt ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:name "supersededAt" ;
        sh:description "UTC instant the supersededBy link was written; the cursor bobbin's feed uses to drop the record." ;
        sh:message "Not recorded: a record is superseded once, at one UTC instant." ] .


aegis:MemoryTopicShape a sh:NodeShape ;
    sh:targetClass aegis:MemoryTopic ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:name "label" ;
        sh:description "The topic's registered name, kebab-case." ;
        sh:message "Not recorded: a topic needs one name (cy topic add <name>)." ] ;
    sh:property [
        sh:path aegis:alias ; sh:datatype xsd:string ;
        sh:name "alias" ;
        sh:description "Another spelling that resolves to this topic." ;
        sh:message "Not recorded: a topic alias is plain text." ] .


aegis:MemoryPreferenceShape a sh:NodeShape ;
    sh:targetClass aegis:Preference ;
    sh:property [
        sh:path aegis:person ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:order 1 ; sh:name "person" ;
        sh:description "Whose preference it is: a Person entity (IRI or local name)." ;
        sh:message "Not recorded: a preference needs whose it is (--person), as an existing person." ] ;
    sh:property [
        sh:path aegis:prefers ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 2 ; sh:name "prefers" ;
        sh:description "What the person prefers, in one sentence." ;
        sh:message "Not recorded: a preference needs what is preferred, in one sentence (--prefers)." ] ;
    sh:property [
        sh:path aegis:context ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "email" "chat" "code-review" "document" "artifact" "form" "travel" ) ;
        sh:order 3 ; sh:name "context" ;
        sh:description "Where it applies: email, chat, code-review, document, artifact, form or travel." ;
        sh:message "Not recorded: a preference needs a context (--context): email, chat, code-review, document, artifact, form or travel." ] ;
    sh:property [
        sh:path aegis:topic ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:order 4 ; sh:name "topic" ;
        sh:description "The registered memory topic (cy topic add registers one)." ;
        sh:message "Not recorded: a preference needs a registered topic (--topic)." ] ;
    sh:property [
        sh:path aegis:notWhen ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 5 ; sh:name "notWhen" ;
        sh:description "When the preference does not apply." ;
        sh:message "Not recorded: give one --not-when." ] ;
    sh:property [
        sh:path aegis:example ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 6 ; sh:name "example" ;
        sh:description "One short example of the preference applied." ;
        sh:message "Not recorded: give one --example." ] ;
    sh:property [
        sh:path aegis:verbatim ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 7 ; sh:name "verbatim" ;
        sh:description "The preference in the person's own words." ;
        sh:message "Not recorded: give one --verbatim quote." ] .


aegis:MemoryHandoffShape a sh:NodeShape ;
    sh:targetClass aegis:Handoff ;
    sh:property [
        sh:path aegis:agent ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:order 1 ; sh:name "agent" ;
        sh:description "The agent the handoff is for (IRI or local name)." ;
        sh:message "Not recorded: a handoff needs the agent it is for (--agent), as an existing agent." ] ;
    sh:property [
        sh:path aegis:next ; sh:minCount 1 ; sh:maxCount 7 ; sh:datatype xsd:string ;
        sh:order 2 ; sh:name "next" ;
        sh:description "A next step pointing at a board item, PR or entity; repeat, 1 to 7." ;
        sh:message "Not recorded: a handoff needs 1 to 7 next steps (--next), each pointing at a board item, PR or entity." ] ;
    sh:property [
        sh:path aegis:waitingOn ; sh:maxCount 7 ; sh:datatype xsd:string ;
        sh:order 3 ; sh:name "waitingOn" ;
        sh:description "What an item waits on; repeat, at most 7." ;
        sh:message "Not recorded: at most 7 --waiting-on lines." ] ;
    sh:property [
        sh:path aegis:handoffContext ; sh:maxCount 3 ; sh:datatype xsd:string ;
        sh:order 4 ; sh:name "context" ;
        sh:description "Context the next session needs; repeat, at most 3 lines." ;
        sh:message "Not recorded: at most 3 --context lines; item state belongs on the board." ] .


aegis:MemoryReferenceShape a sh:NodeShape ;
    sh:targetClass aegis:Reference ;
    sh:property [
        sh:path aegis:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:order 1 ; sh:name "subject" ;
        sh:description "The system the reference points into: host, service, repo or tool (IRI or local name)." ;
        sh:message "Not recorded: a reference needs the system it points into (--subject), as an existing entity." ] ;
    sh:property [
        sh:path aegis:topic ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:order 2 ; sh:name "topic" ;
        sh:description "What the reference is for: a registered memory topic (cy topic add registers one)." ;
        sh:message "Not recorded: a reference needs a registered topic saying what it is for (--topic)." ] ;
    sh:property [
        sh:path aegis:locator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 3 ; sh:name "locator" ;
        sh:description "Where it is: a URL, path, command or graph IRI. Never a secret." ;
        sh:message "Not recorded: a reference needs where it is (--locator): a URL, path, command or graph IRI." ] ;
    sh:property [
        sh:path aegis:secretRef ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^[A-Za-z][A-Za-z0-9_./-]{1,127}$" ;
        sh:order 4 ; sh:name "secretRef" ;
        sh:description "The secret-store key name that holds the credential. A key name, never a value." ;
        sh:message "Not recorded: --secret-ref must be a secret-store key name, not a value." ] ;
    sh:property [
        sh:path aegis:access ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 5 ; sh:name "access" ;
        sh:description "How to authenticate, in one sentence, without the secret." ;
        sh:message "Not recorded: give one --access sentence." ] .


# Generated from shapes/agent-memory.shapes.ttl sha256:356db1c9c33c8e806b1fda6669fab3f80ab9d6b818f1aee967686145b17e9737
# by scripts/memory_schema_proposal.py (aegis-gshu.12). Do not hand-edit.
@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .

aegis:MemoryDirectiveBodyShape a sh:NodeShape ;
    sh:property [
        sh:path aegis:rule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 1 ; sh:name "rule" ;
        sh:description "The rule, as one imperative sentence." ;
        sh:message "Not recorded: a directive needs the rule as one imperative sentence (--rule)." ] ;
    sh:property [
        sh:path aegis:issuedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:order 2 ; sh:name "issuedBy" ;
        sh:description "Who issued the rule: a Person or agent entity (IRI or local name)." ;
        sh:message "Not recorded: a directive needs who issued it (--issued-by), as an existing person or agent." ] ;
    sh:property [
        sh:path aegis:appliesTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:order 3 ; sh:name "appliesTo" ;
        sh:description "Who or what the rule binds: an agent, CrewRole or repo, or 'crew' for everyone." ;
        sh:message "Not recorded: a directive needs who it applies to (--applies-to), an existing agent, role or repo, or 'crew'." ] ;
    sh:property [
        sh:path aegis:topic ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:order 4 ; sh:name "topic" ;
        sh:description "The registered memory topic the rule governs (cy topic add registers one)." ;
        sh:message "Not recorded: a directive needs a registered topic (--topic)." ] ;
    sh:property [
        sh:path aegis:issuedOn ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
        sh:order 5 ; sh:name "issuedOn" ;
        sh:description "The date the rule was given, YYYY-MM-DD." ;
        sh:message "Not recorded: --issued-on is one date, YYYY-MM-DD." ] ;
    sh:property [
        sh:path aegis:why ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 6 ; sh:name "why" ;
        sh:description "Why the rule exists, in one sentence." ;
        sh:message "Not recorded: give one --why." ] ;
    sh:property [
        sh:path aegis:verbatim ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:order 7 ; sh:name "verbatim" ;
        sh:description "The rule in the issuer's own words." ;
        sh:message "Not recorded: give one --verbatim quote." ] .


# Scoped: only memory records (subjects of aegis:naturalKey) typed aegis:Directive are
# checked. The live aegis:Directive nodes written before camayoc have no naturalKey
# and stay untouched until someone rewrites them as memory records.
aegis:MemoryDirectiveShape a sh:NodeShape ;
    sh:targetSubjectsOf aegis:naturalKey ;
    sh:or ( [ sh:not [ sh:class aegis:Directive ] ] [ sh:node aegis:MemoryDirectiveBodyShape ] ) ;
    sh:message "A memory Directive needs --rule, --issued-by, --applies-to and --topic, each exactly once. Run the cy create tool with --help for each field." .


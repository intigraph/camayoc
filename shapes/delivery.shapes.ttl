@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Delivery vocabulary: deployment outcomes ingested as CDEvents (aegis-rb3).
#
# Accepted as Quipu schema proposal 31 (dearing, 2026-10-15T02:08:44Z): a new
# DeploymentEvent class, distinct from WorkflowRun, Incident and the shuttle
# TransitionEvent, reusing Service (deployedService) and keeping the artifact
# as a purl string. STANDALONE: this file carries its own prefixes and the
# class and predicate declarations, so it loads as one shape set and does not
# depend on core.shapes.ttl or the ontology having been loaded first.
#
# What SHACL proves here is the record's shape. Monthly window routing, the
# source+id identity and replay byte-identity are producer guarantees
# (scripts/ingest_cdevents.py and its tests), not provable by a shape.
#
# occurredAt: this shape enforces RFC 3339 LEXICAL form with legal RANGES
# (month 01-12, day 01-31, hour 00-23, minute and second 00-59, offset at most
# 23:59). It does NOT prove calendar validity per month (2026-02-30 or
# 2025-02-29 are lexically in range). That is a producer guarantee:
# ingest_cdevents.event_month() quarantines any impossible instant BEFORE a
# window is chosen, and tests/test_delivery_shapes.py proves both halves of
# that contract on the same values. Leap seconds (:60) are quarantined by the
# producer and refused here.

aegis:DeploymentEvent a rdfs:Class ;
    rdfs:label "Deployment event" ;
    rdfs:comment "One deployment outcome of a service on an environment, from a CDEvents service event. succeeded, rolledback or failed; never coerced from service.removed. On rollback, artifactId is what serves AFTER the rollback and attemptedArtifactId is what did not stick." .

aegis:deployedService a rdf:Property ;
    rdfs:label "deployed service" ;
    rdfs:comment "The service entity the deployment changed." .

aegis:artifactId a rdf:Property ;
    rdfs:label "artifact id" ;
    rdfs:comment "Package URL (purl) of the artifact serving after this outcome. Required for succeeded and rolledback; on failed, present only when independently observed." ;
    rdfs:range xsd:string .

aegis:attemptedArtifactId a rdf:Property ;
    rdfs:label "attempted artifact id" ;
    rdfs:comment "Package URL of the artifact a rolled-back or failed deployment attempted. Required for failed." ;
    rdfs:range xsd:string .

aegis:environment a rdf:Property ;
    rdfs:label "environment" ;
    rdfs:comment "The environment the deployment targeted, as the producer names it." ;
    rdfs:range xsd:string .

aegis:deploymentOutcome a rdf:Property ;
    rdfs:label "deployment outcome" ;
    rdfs:comment "Closed set: succeeded, rolledback, failed. Change failure rate counts rolledback and failed." ;
    rdfs:range xsd:string .

aegis:occurredAt a rdf:Property ;
    rdfs:label "occurred at" ;
    rdfs:comment "RFC 3339 instant the outcome happened (the CloudEvent time), kept in the producer's exact lexical form. Calendar validity is enforced at ingest; the shape checks lexical form and field ranges." ;
    rdfs:range xsd:string .

aegis:cdeventsType a rdf:Property ;
    rdfs:label "CDEvents type" ;
    rdfs:comment "The versioned CDEvents type the record was mapped from." ;
    rdfs:range xsd:string .

aegis:cloudEventSource a rdf:Property ;
    rdfs:label "CloudEvent source" ;
    rdfs:comment "CloudEvents source attribute; with cloudEventId, the event's identity." ;
    rdfs:range xsd:string .

aegis:cloudEventId a rdf:Property ;
    rdfs:label "CloudEvent id" ;
    rdfs:comment "CloudEvents id attribute; unique within its source." ;
    rdfs:range xsd:string .

aegis:DeploymentEventShape a sh:NodeShape ;
    sh:targetClass aegis:DeploymentEvent ;
    sh:property [ sh:path aegis:sourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("observed") ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:deployedService ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path aegis:artifactId ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^pkg:[a-z]+/" ] ;
    sh:property [ sh:path aegis:attemptedArtifactId ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^pkg:[a-z]+/" ] ;
    sh:property [ sh:path aegis:environment ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path aegis:deploymentOutcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("succeeded" "failed" "rolledback") ] ;
    sh:property [ sh:path aegis:occurredAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ] ;
    sh:property [ sh:path aegis:cdeventsType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^dev\\.cdevents\\." ] ;
    sh:property [ sh:path aegis:cloudEventSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path aegis:cloudEventId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    # Which artifact a record must name depends on its outcome. succeeded and
    # rolledback name what serves AFTER (artifactId). failed names what it
    # ATTEMPTED; a serving artifact is optional there and only ever observed,
    # never copied from the attempt. Written as two implications so a failed
    # record cannot satisfy them with a serving artifact alone, and so a
    # malformed outcome (absent, unknown, or two) is reported once, by its own
    # constraint above, not again here.
    sh:or (
        [ sh:not [ sh:property [ sh:path aegis:deploymentOutcome ; sh:hasValue "failed" ] ] ]
        [ sh:property [ sh:path aegis:deploymentOutcome ; sh:minCount 2 ] ]
        [ sh:property [ sh:path aegis:attemptedArtifactId ; sh:minCount 1 ] ]
    ) ;
    sh:or (
        [ sh:property [ sh:path aegis:deploymentOutcome ; sh:hasValue "failed" ] ]
        [ sh:property [ sh:path aegis:artifactId ; sh:minCount 1 ] ]
    ) .

# Change vocabulary: pull-request lifecycle ingested as CDEvents (aegis-rb3,
# 2026-10-22). Lead time is a join, not a guess: a ChangeEvent with
# changeAction "merged" names its merge commit, and the deployment that first
# includes that commit (aegis:includesCommit) is when the change reached
# production. A change whose merge commit no succeeded deployment includes is
# NOT deployed, whatever the clock says.

aegis:ChangeEvent a rdfs:Class ;
    rdfs:label "Change event" ;
    rdfs:comment "One lifecycle step of a source change (a pull request), from a CDEvents change event or a CI result for the change's head commit: created, reviewed, merged, abandoned, ci-passed or ci-failed. Distinct from DeploymentEvent (what reached an environment) and from WorkflowRun." .

aegis:changeId a rdf:Property ;
    rdfs:label "change id" ;
    rdfs:comment "Repository-qualified change identity, owner/repo#number. Every step of one change carries the same value." ;
    rdfs:range xsd:string .

aegis:changeRepository a rdf:Property ;
    rdfs:label "change repository" ;
    rdfs:comment "The repository the change targets, as owner/repo." ;
    rdfs:range xsd:string .

aegis:changeAction a rdf:Property ;
    rdfs:label "change action" ;
    rdfs:comment "Closed set: created, reviewed, merged, abandoned, ci-passed, ci-failed." ;
    rdfs:range xsd:string .

aegis:commitSha a rdf:Property ;
    rdfs:label "commit sha" ;
    rdfs:comment "Full 40-hex commit id the step concerns: the merge commit on merged, the head commit on a CI result or review." ;
    rdfs:range xsd:string .

aegis:reviewState a rdf:Property ;
    rdfs:label "review state" ;
    rdfs:comment "The forge's review verdict word on a reviewed step (approved, changes_requested, commented, dismissed)." ;
    rdfs:range xsd:string .

aegis:includesCommit a rdf:Property ;
    rdfs:label "includes commit" ;
    rdfs:comment "Full 40-hex commit id newly delivered by a deployment: the commits reachable from the deployed artifact and not from the previous succeeded deployment's artifact. Multi-valued." ;
    rdfs:range xsd:string .

aegis:DeploymentEventIncludesShape a sh:NodeShape ;
    sh:targetClass aegis:DeploymentEvent ;
    sh:property [ sh:path aegis:includesCommit ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{40}$" ] .

aegis:ChangeEventShape a sh:NodeShape ;
    sh:targetClass aegis:ChangeEvent ;
    sh:property [ sh:path aegis:sourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("observed") ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:changeId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$" ] ;
    sh:property [ sh:path aegis:changeRepository ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" ] ;
    sh:property [ sh:path aegis:changeAction ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("created" "reviewed" "merged" "abandoned" "ci-passed" "ci-failed") ] ;
    sh:property [ sh:path aegis:commitSha ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{40}$" ] ;
    sh:property [ sh:path aegis:reviewState ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path aegis:eventActor ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path aegis:occurredAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ] ;
    sh:property [ sh:path aegis:cdeventsType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^dev\\.cdevents\\." ] ;
    sh:property [ sh:path aegis:cloudEventSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path aegis:cloudEventId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    # A merge names the commit that a deployment must include for the change to
    # count as delivered; without it, merge->deployed would be unjoinable.
    sh:or (
        [ sh:not [ sh:property [ sh:path aegis:changeAction ; sh:hasValue "merged" ] ] ]
        [ sh:property [ sh:path aegis:commitSha ; sh:minCount 1 ] ]
    ) .

# Competency delivery-and-dora.md questions 9–10. Source support is separate
# from schema admission and producer activation.
aegis:eventActor a rdf:Property ;
    rdfs:label "acting event principal" ;
    rdfs:comment "The forge principal that performed the merge or publication, not the ingress writer." ;
    rdfs:range xsd:string .

aegis:releaseTag a rdf:Property ;
    rdfs:label "release tag" ;
    rdfs:range xsd:string .

aegis:ReleaseEvent a rdfs:Class ;
    rdfs:label "artifact publication event" ;
    rdfs:comment "An artifact.published CDEvent, identified by CloudEvent source and id, with the resolved release commit." .

aegis:ReleaseEventShape a sh:NodeShape ;
    sh:targetClass aegis:ReleaseEvent ;
    sh:property [ sh:path aegis:sourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("observed") ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:artifactId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^pkg:[a-z][a-z0-9.+-]*/[^\\s]+@[^\\s]+$" ] ;
    sh:property [ sh:path aegis:changeRepository ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" ] ;
    sh:property [ sh:path aegis:commitSha ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{40}$" ] ;
    sh:property [ sh:path aegis:releaseTag ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path aegis:eventActor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path aegis:occurredAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" ] ;
    sh:property [ sh:path aegis:cdeventsType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^dev\\.cdevents\\.artifact\\.published\\." ] ;
    sh:property [ sh:path aegis:cloudEventSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path aegis:cloudEventId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

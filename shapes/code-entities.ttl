# SHACL shapes for Bobbin code entity types.
#
# Defines validation constraints for CodeModule, CodeSymbol, Document,
# Section, and Bundle — the core entity model for knowledge-aware bundles.
#
# Load via POST /shapes:
#   curl -s localhost:3030/shapes -X POST \
#     -H "Content-Type: application/json" \
#     -d '{"action": "load", "name": "code-entities", "turtle": "<contents>"}'

@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix quipu: <http://quipu.dev/ontology/> .
@prefix bobbin: <http://aegis.gastown.local/ontology/> .
# Same IRI as bobbin: above — spelled aegis: where the term is aegis's, so a reader
# grepping core.shapes.ttl for sourceKind finds the same prefix on both sides.
@prefix aegis:  <http://aegis.gastown.local/ontology/> .

# ── CodeModule ─────────────────────────────────────────────────
#
# A source file in a repository. Every code module must declare its
# file path, repository, and programming language.

bobbin:CodeModuleShape a sh:NodeShape ;
    sh:targetClass bobbin:CodeModule ;
    # PROVENANCE TAG — value-constrained, deliberately NOT required yet.
    #
    # camayoc-42d: core.shapes.ttl makes aegis:sourceKind mandatory on every
    # WorkItem and Decision ("the tag is the reader's only signal of trust"),
    # and code entities carry no such tag — so seed writes land untagged and a
    # reader cannot tell an observed fact from an inferred one.
    #
    # sh:minCount 1 is the obvious fix and it is the WRONG FIRST MOVE here, for
    # the reason this file already states four times above: never require a
    # predicate the emitter does not emit. Bobbin's promotion path has not been
    # measured for sourceKind, and that measurement must be made on the DEPLOYED
    # binary rather than its source — the same discipline that ordered the
    # rdfs:label constraint AFTER the emitter shipped it, across 15,311 entities.
    # Requiring it blind would refuse every promotion and leave the hourly
    # ingest's marker unadvanced, which is precisely the failure those notes
    # record having already avoided once.
    #
    # So this is the advise-before-enforce half: the vocabulary is CLOSED, so a
    # write carrying a sourceKind camayoc does not recognise fails now, while a
    # write carrying none still passes. That converts the open question from
    # "are these tagged?" to "are the tags we get valid?", and it cannot stall
    # anything. Tightening to minCount 1 is a second step, gated on counting
    # sourceKind over a live sample the way the label constraint was.
    sh:property [
        sh:path aegis:sourceKind ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: sourceKind, when present, is one of observed|declared|inferred — the same closed vocabulary core.shapes.ttl requires (camayoc-42d)" ;
    ] ;
    # rdfs:label is REQUIRED. Ordered AFTER the emitter shipped, not before, and
    # the order is measured rather than stylistic: the previous exporter emitted
    # these four classes with NO label at all, so this constraint would have
    # refused every promotion and left the hourly ingest's marker unadvanced —
    # advise before enforce (see the bead). Verified on the DEPLOYED binary
    # before this landed, not on its source, and across every repo the lane
    # ingests: 15,311 entities, none unlabelled.
    #
    #     CodeModule 127/127   CodeSymbol 1850/1850  Document 29/29   Section 176/176
    #     CodeModule 144/144   CodeSymbol 7638/7638  Document 57/57   Section 541/541
    #     CodeModule 148/148   CodeSymbol 3436/3436  Document 154/154 Section 1011/1011
    #
    # xsd:string matches BundleShape/CommitShape below: the exporter writes plain
    # literals, which are xsd:string in RDF 1.1. A language-tagged label would be
    # rdf:langString and would NOT satisfy this — intentional, and consistent with
    # those neighbours. Same rule as the in_repo note above: never require a
    # predicate the emitter does not emit.
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:filePath ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:repo ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:language ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    # bobbin:repo above is a LITERAL STRING and stays one — it is what the
    # bobbin promotion path emits. But a string is not walkable: it left all
    # 10,143 code entities unable to reach the ownership layer sitting beside
    # them (0 of 537 modules had any edge to a repo_<name> entity).
    # in_repo is the IRI counterpart: the edge that makes owns / shepherds /
    # managed_by reachable from a source file in two hops.
    #
    # NOT minCount 1, deliberately — same rule as CommitShape below: never
    # require a predicate the emitter does not emit. Bobbin writes bobbin:repo,
    # not bobbin:in_repo, so requiring it here would fail every future promotion.
    # Backfilling it stays a reconciliation step until the emitter learns to
    # write it (see the bead).
    #
    # ⚠ in_repo is RANGE-MIXED across the store and this constraint does not
    # change that: CommitShape constrains the SAME predicate to xsd:string, and
    # ~443 Commit/GitCommit entities use the literal form. The two senses are
    # scoped by targetClass, so `?x in_repo ?r` unfiltered returns both strings
    # and IRIs. Bind the subject's type, or test isIRI(?r), before relying on it.
    # NOT sh:class bobbin:Repo, deliberately — measured, not assumed. SHACL here
    # validates the SUBMITTED turtle in isolation, never the store, so sh:class
    # would demand every writer redundantly re-assert `repo_x a bobbin:Repo` in
    # the same payload; omitting it failed with a `class` violation on an
    # otherwise-correct write. A constraint that fails correct writes is one
    # people learn to bypass. nodeKind alone catches the disease this edge exists
    # to cure (a literal string where a walkable IRI belongs) — it fired on
    # exactly that case in testing. Residual, accepted: the target being a *Repo*
    # is not checkable at write time; that needs a store-aware validator.
    sh:property [
        sh:path bobbin:in_repo ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .

# ── CodeSymbol ─────────────────────────────────────────────────
#
# A named symbol (function, class, method, etc.) defined within a
# CodeModule. The symbolKind is an enumerated string drawn from
# common language-server symbol categories.

bobbin:CodeSymbolShape a sh:NodeShape ;
    sh:targetClass bobbin:CodeSymbol ;
    # PROVENANCE TAG — value-constrained, deliberately NOT required yet.
    #
    # camayoc-42d: core.shapes.ttl makes aegis:sourceKind mandatory on every
    # WorkItem and Decision ("the tag is the reader's only signal of trust"),
    # and code entities carry no such tag — so seed writes land untagged and a
    # reader cannot tell an observed fact from an inferred one.
    #
    # sh:minCount 1 is the obvious fix and it is the WRONG FIRST MOVE here, for
    # the reason this file already states four times above: never require a
    # predicate the emitter does not emit. Bobbin's promotion path has not been
    # measured for sourceKind, and that measurement must be made on the DEPLOYED
    # binary rather than its source — the same discipline that ordered the
    # rdfs:label constraint AFTER the emitter shipped it, across 15,311 entities.
    # Requiring it blind would refuse every promotion and leave the hourly
    # ingest's marker unadvanced, which is precisely the failure those notes
    # record having already avoided once.
    #
    # So this is the advise-before-enforce half: the vocabulary is CLOSED, so a
    # write carrying a sourceKind camayoc does not recognise fails now, while a
    # write carrying none still passes. That converts the open question from
    # "are these tagged?" to "are the tags we get valid?", and it cannot stall
    # anything. Tightening to minCount 1 is a second step, gated on counting
    # sourceKind over a live sample the way the label constraint was.
    sh:property [
        sh:path aegis:sourceKind ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: sourceKind, when present, is one of observed|declared|inferred — the same closed vocabulary core.shapes.ttl requires (camayoc-42d)" ;
    ] ;
    # rdfs:label is REQUIRED. Ordered AFTER the emitter shipped, not before, and
    # the order is measured rather than stylistic: the previous exporter emitted
    # these four classes with NO label at all, so this constraint would have
    # refused every promotion and left the hourly ingest's marker unadvanced —
    # advise before enforce (see the bead). Verified on the DEPLOYED binary
    # before this landed, not on its source, and across every repo the lane
    # ingests: 15,311 entities, none unlabelled.
    #
    #     CodeModule 127/127   CodeSymbol 1850/1850  Document 29/29   Section 176/176
    #     CodeModule 144/144   CodeSymbol 7638/7638  Document 57/57   Section 541/541
    #     CodeModule 148/148   CodeSymbol 3436/3436  Document 154/154 Section 1011/1011
    #
    # xsd:string matches BundleShape/CommitShape below: the exporter writes plain
    # literals, which are xsd:string in RDF 1.1. A language-tagged label would be
    # rdf:langString and would NOT satisfy this — intentional, and consistent with
    # those neighbours. Same rule as the in_repo note above: never require a
    # predicate the emitter does not emit.
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:symbolKind ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in (
            "function" "method" "class" "interface" "enum"
            "struct" "variable" "constant" "module" "property"
            "field" "constructor" "type_alias"
        ) ;
    ] ;
    sh:property [
        sh:path bobbin:definedIn ;
        sh:class bobbin:CodeModule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# ── Document ───────────────────────────────────────────────────
#
# A documentation file (Markdown, RST, plain text, etc.).

# Keep the existing shared class sanctioned when this set is loaded alone.
# Vocabulary admission uses targetClass; this declaration adds no constraints.
bobbin:DocumentVocabularyShape a sh:NodeShape ;
    sh:targetClass bobbin:Document .

bobbin:DocumentShape a sh:NodeShape ;
    # Document is a shared vocabulary class, including ordinary write-ups.
    # Repository documents are the objects of chunk/section inDocument links.
    # A filePath on an unrelated subject does not establish this ownership.
    sh:targetObjectsOf bobbin:inDocument ;
    # PROVENANCE TAG — value-constrained, deliberately NOT required yet.
    #
    # camayoc-42d: core.shapes.ttl makes aegis:sourceKind mandatory on every
    # WorkItem and Decision ("the tag is the reader's only signal of trust"),
    # and code entities carry no such tag — so seed writes land untagged and a
    # reader cannot tell an observed fact from an inferred one.
    #
    # sh:minCount 1 is the obvious fix and it is the WRONG FIRST MOVE here, for
    # the reason this file already states four times above: never require a
    # predicate the emitter does not emit. Bobbin's promotion path has not been
    # measured for sourceKind, and that measurement must be made on the DEPLOYED
    # binary rather than its source — the same discipline that ordered the
    # rdfs:label constraint AFTER the emitter shipped it, across 15,311 entities.
    # Requiring it blind would refuse every promotion and leave the hourly
    # ingest's marker unadvanced, which is precisely the failure those notes
    # record having already avoided once.
    #
    # So this is the advise-before-enforce half: the vocabulary is CLOSED, so a
    # write carrying a sourceKind camayoc does not recognise fails now, while a
    # write carrying none still passes. That converts the open question from
    # "are these tagged?" to "are the tags we get valid?", and it cannot stall
    # anything. Tightening to minCount 1 is a second step, gated on counting
    # sourceKind over a live sample the way the label constraint was.
    sh:property [
        sh:path aegis:sourceKind ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: sourceKind, when present, is one of observed|declared|inferred — the same closed vocabulary core.shapes.ttl requires (camayoc-42d)" ;
    ] ;
    # rdfs:label is REQUIRED. Ordered AFTER the emitter shipped, not before, and
    # the order is measured rather than stylistic: the previous exporter emitted
    # these four classes with NO label at all, so this constraint would have
    # refused every promotion and left the hourly ingest's marker unadvanced —
    # advise before enforce (see the bead). Verified on the DEPLOYED binary
    # before this landed, not on its source, and across every repo the lane
    # ingests: 15,311 entities, none unlabelled.
    #
    #     CodeModule 127/127   CodeSymbol 1850/1850  Document 29/29   Section 176/176
    #     CodeModule 144/144   CodeSymbol 7638/7638  Document 57/57   Section 541/541
    #     CodeModule 148/148   CodeSymbol 3436/3436  Document 154/154 Section 1011/1011
    #
    # xsd:string matches BundleShape/CommitShape below: the exporter writes plain
    # literals, which are xsd:string in RDF 1.1. A language-tagged label would be
    # rdf:langString and would NOT satisfy this — intentional, and consistent with
    # those neighbours. Same rule as the in_repo note above: never require a
    # predicate the emitter does not emit.
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:filePath ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# ── Section ────────────────────────────────────────────────────
#
# A headed section within a Document. headingDepth is a positive
# integer (1 = top-level heading, 2 = sub-heading, etc.).

bobbin:SectionShape a sh:NodeShape ;
    sh:targetClass bobbin:Section ;
    # PROVENANCE TAG — value-constrained, deliberately NOT required yet.
    #
    # camayoc-42d: core.shapes.ttl makes aegis:sourceKind mandatory on every
    # WorkItem and Decision ("the tag is the reader's only signal of trust"),
    # and code entities carry no such tag — so seed writes land untagged and a
    # reader cannot tell an observed fact from an inferred one.
    #
    # sh:minCount 1 is the obvious fix and it is the WRONG FIRST MOVE here, for
    # the reason this file already states four times above: never require a
    # predicate the emitter does not emit. Bobbin's promotion path has not been
    # measured for sourceKind, and that measurement must be made on the DEPLOYED
    # binary rather than its source — the same discipline that ordered the
    # rdfs:label constraint AFTER the emitter shipped it, across 15,311 entities.
    # Requiring it blind would refuse every promotion and leave the hourly
    # ingest's marker unadvanced, which is precisely the failure those notes
    # record having already avoided once.
    #
    # So this is the advise-before-enforce half: the vocabulary is CLOSED, so a
    # write carrying a sourceKind camayoc does not recognise fails now, while a
    # write carrying none still passes. That converts the open question from
    # "are these tagged?" to "are the tags we get valid?", and it cannot stall
    # anything. Tightening to minCount 1 is a second step, gated on counting
    # sourceKind over a live sample the way the label constraint was.
    sh:property [
        sh:path aegis:sourceKind ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: sourceKind, when present, is one of observed|declared|inferred — the same closed vocabulary core.shapes.ttl requires (camayoc-42d)" ;
    ] ;
    # rdfs:label is REQUIRED. Ordered AFTER the emitter shipped, not before, and
    # the order is measured rather than stylistic: the previous exporter emitted
    # these four classes with NO label at all, so this constraint would have
    # refused every promotion and left the hourly ingest's marker unadvanced —
    # advise before enforce (see the bead). Verified on the DEPLOYED binary
    # before this landed, not on its source, and across every repo the lane
    # ingests: 15,311 entities, none unlabelled.
    #
    #     CodeModule 127/127   CodeSymbol 1850/1850  Document 29/29   Section 176/176
    #     CodeModule 144/144   CodeSymbol 7638/7638  Document 57/57   Section 541/541
    #     CodeModule 148/148   CodeSymbol 3436/3436  Document 154/154 Section 1011/1011
    #
    # xsd:string matches BundleShape/CommitShape below: the exporter writes plain
    # literals, which are xsd:string in RDF 1.1. A language-tagged label would be
    # rdf:langString and would NOT satisfy this — intentional, and consistent with
    # those neighbours. Same rule as the in_repo note above: never require a
    # predicate the emitter does not emit.
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:heading ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:headingDepth ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# ── Bundle ─────────────────────────────────────────────────────
#
# A named collection of code entities. Must have a label and contain
# at least one member (CodeModule, CodeSymbol, Document, or Section).

bobbin:BundleShape a sh:NodeShape ;
    sh:targetClass bobbin:Bundle ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:contains ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class bobbin:CodeModule ]
            [ sh:class bobbin:CodeSymbol ]
            [ sh:class bobbin:Document ]
            [ sh:class bobbin:Section ]
        ) ;
    ] .

# ── Commit ─────────────────────────────────────────────────────
#
# A git commit emitted by the promotion path (bobbin → quipu). Hundreds of live
# Commit entities were invisible to validation until this shape: no shape file
# declared the kind. Constraints are reconciled to what the emitter ACTUALLY
# writes — measured over a live sample (never require a predicate the emitter
# does not emit). Required set = present on every sampled commit and single-
# valued; touches/references are optional object properties (0..N IRIs).

bobbin:CommitShape a sh:NodeShape ;
    sh:targetClass bobbin:Commit ;
    sh:property [
        sh:path bobbin:sha ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:author ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:in_repo ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:touches ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path bobbin:references ;
        sh:nodeKind sh:IRI ;
    ] .

# ── Chunk ──────────────────────────────────────────────────────
#
# A retrievable piece of a Document or CodeModule — the unit bobbin's
# index stores and its structural-edge graph relates (adjacency,
# containment). Owed to competency/document-structure-and-chunks.md
# questions 1-9; the emitter is bobbin's /knot snapshot lane
# (bobbin docs/plans/bobbin-roadmap.md W2.P4).
#
# EVERY property here is advisory — value-constrained, nothing required.
# This is one step earlier on the advise-before-enforce ladder than the
# shapes above: Section's minCounts were ordered AFTER its emitter shipped
# and was measured across 15,311 live entities; the Chunk emitter has not
# shipped at all, so there is no live output to measure yet. Requiring any
# predicate now would refuse the first promotion the emitter ever attempts.
# Tightening comes after counting the deployed emitter's output, exactly
# as rdfs:label was tightened above.
#
# Relationship vocabulary notes:
#   - bobbin:inDocument (not aegis:contains) links a Chunk to its Document
#     or CodeModule — the same dodge SectionShape's emitter uses, because
#     aegis:contains is bound to sh:class aegis:Bead in provenance shapes
#     via sh:targetSubjectsOf and would fire on any subject.
#   - bobbin:nextChunk is set-semantics adjacency: each chunk has at most
#     one successor in document order.
#   - bobbin:chunkOrder is the aegis:stepOrder idiom (xsd:integer) applied
#     to document position.

bobbin:ChunkShape a sh:NodeShape ;
    sh:targetClass bobbin:Chunk ;
    sh:property [
        sh:path aegis:sourceKind ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: sourceKind, when present, is one of observed|declared|inferred — the same closed vocabulary core.shapes.ttl requires (camayoc-42d)" ;
    ] ;
    sh:property [
        sh:path bobbin:inDocument ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path bobbin:nextChunk ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "camayoc: nextChunk is document-order adjacency — at most one successor per chunk" ;
    ] ;
    sh:property [
        sh:path bobbin:chunkOrder ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path bobbin:filePath ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
    ] .

# Temporary stored-data debt profiles: each routes independently to EMIT.
# Counts are validation results on a retained snapshot, not entity counts.
# Inline property shapes carry Warning too: severity does not inherit from
# their containing NodeShape. This keeps import/compose advisory as intended.
# Restore REJECT only after a measured zero and the normal reviewed shape lane.

# Owner: Gennaro; burn-down aegis-42fj; due 2026-11-05.
# Retained ROOT label maxCount: 6268 reported; selected union summary 6263.
bobbin:CodeEntityLabelMaxCountDebtShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:severity sh:Warning ;
    sh:targetClass bobbin:Chunk, bobbin:CodeModule, bobbin:CodeSymbol,
        bobbin:Section, bobbin:Bundle, bobbin:Commit ;
    sh:targetObjectsOf bobbin:inDocument ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path rdfs:label ;
        sh:maxCount 1 ;
    ] .

# Owner: Gennaro; burn-down aegis-czs9; due 2026-11-05.
# Retained ROOT heading maxCount: 2381, including dual-typed Chunk/Section.
# ChunkShape has no heading constraint; do not invent one while splitting.
bobbin:SectionHeadingMaxCountDebtShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:severity sh:Warning ;
    sh:targetClass bobbin:Section ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path bobbin:heading ;
        sh:maxCount 1 ;
    ] .

# Owner: Grant; burn-down aegis-yqfk; due 2026-11-05.
# Retained ROOT minimum counts: sha 1075, in_repo 1076 result rows.
# Datatype and maximum count remain in CommitShape and still reject.
bobbin:CommitRequiredMetadataDebtShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:severity sh:Warning ;
    sh:targetClass bobbin:Commit ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path bobbin:sha ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path bobbin:in_repo ;
        sh:minCount 1 ;
    ] .

# Owner: Gennaro; burn-down aegis-e4ec; due 2026-11-05.
# Retained union: 710 filePath results across the Document family, of which
# 10 have CodeModule type. Recount this precise target after Document scoping.
# Document's filePath datatype/cardinality is NOT in this emit profile.
bobbin:CodeModuleFilePathDebtShape a sh:NodeShape ;
    quipu:onViolation "emit" ;
    sh:severity sh:Warning ;
    sh:targetClass bobbin:CodeModule ;
    sh:property [
        sh:severity sh:Warning ;
        sh:path bobbin:filePath ;
        sh:minCount 1 ;
    ] .

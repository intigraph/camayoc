# camayoc legacy WorkItem compatibility (aegis-452)
#
# Core no longer targets aegis:WorkItem: new work is schema:Action under the
# Seeds profile. The tracker projection still writes WorkItem records, and with
# no shape targeting them an invalid record is stored without complaint
# (measured on the production set union: sourceKind "guessed" accepted).
#
# Load this set alongside core while that projection exists. It carries only
# the WorkItem constraints core dropped and nothing core already covers:
# inWorkflowRun is ActionWorkflowRunShape, and blockedOn is LegacyBlockedOnShape.
# The shape IRI is the one validation reports have always named.
#
# Retire it when the projection writes schema:Action instead (aegis-v8dp).

@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

aegis:CamayocWorkItemShape a sh:NodeShape ;
    sh:targetClass aegis:WorkItem ;
    sh:property [
        sh:path aegis:sourceKind ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: every WorkItem carries exactly one sourceKind of observed|declared|inferred — the tag is the reader's only signal of trust" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "camayoc: a WorkItem needs exactly one rdfs:label" ;
    ] ;
    sh:property [
        sh:path aegis:outcome ;
        sh:maxCount 1 ;
        sh:in ("done" "abandoned" "superseded" "failed") ;
        sh:message "camayoc: outcome, when set, is one of done|abandoned|superseded|failed — absence means open; never store a decaying 'in progress'" ;
    ] .
